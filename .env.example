# App
APP_ENV=development
APP_NAME=golang-server
LOG_LEVEL=debug

# HTTP server
PORT=8080
HTTP_HOST=0.0.0.0
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_DRAIN_DELAY=0s
HTTP_REQUEST_ID_HEADER=
HTTP_CLIENT_IP_HEADER=
HTTP_MAX_HEADER_BYTES=65536
# Prometheus metrics on a private port; empty turns them off
METRICS_ADDR=

# Postgres
POSTGRES_USER=golang-server
POSTGRES_PASSWORD=change-me
POSTGRES_DB=golang-server
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_IDLE=15m
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_CHECK_PERIOD=1m
DB_READY_TIMEOUT=2s

# SuperTokens core database: same Postgres server, separate database and login
SUPERTOKENS_DB_USER=supertokens
SUPERTOKENS_DB_PASSWORD=change-me
SUPERTOKENS_DB_NAME=supertokens

# CORS: every SUPERTOKENS_WEBSITE_DOMAINS entry must also be listed here
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_MAX_AGE=10m

# SuperTokens: API key must match the core's API_KEYS, 20+ characters: openssl rand -hex 24
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=change-me-to-20-or-more-characters
SUPERTOKENS_APP_NAME=Example
SUPERTOKENS_API_DOMAIN=http://localhost:8080
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_DOMAINS=http://localhost:4321,http://localhost:5173,http://localhost:5174,http://localhost:5175
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
SUPERTOKENS_TIMEOUT=5s

# Sign-in code send limits as limit/period pairs; every window applies
AUTH_RATE_LIMIT_DESTINATION=5/15m,15/24h
AUTH_RATE_LIMIT_CLIENT_IP=30/1h,100/24h
AUTH_RATE_LIMIT_SMS_TOTAL=1000/1h,5000/24h

# General request limits per instance; every window applies
RATE_LIMIT_CLIENT_IP=600/1m
RATE_LIMIT_USER=120/1m,3000/1h

# Admin sign-in with OpenID Connect; empty OIDC_ISSUER disables it.
# Google Workspace: OIDC_ISSUER=https://accounts.google.com, OIDC_HOSTED_DOMAIN and ADMIN_EMAIL_DOMAIN=coniungolabs.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_HOSTED_DOMAIN=
ADMIN_EMAIL_DOMAIN=
ADMIN_API_HOST=
ADMIN_SESSION_MAX_AGE=12h

# Delivery: log prints codes to the console and is rejected in production
EMAIL_PROVIDER=log
EMAIL_FROM="Example <hello@example.com>"
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
SMS_PROVIDER=log
SMS_SENDER=Example
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_CHANNEL=dnd
DELIVERY_TIMEOUT=10s

# Hashes phones, emails and IPs in sign_in_attempts. 32+ characters: openssl rand -hex 32
FINGERPRINT_SECRET=change-me-to-32-or-more-random-characters

# Phone numbers: ISO 3166-1 alpha-2 codes; empty allowed list accepts every country
PHONE_DEFAULT_REGION=NG
PHONE_ALLOWED_REGIONS=

# Swagger UI at /docs/ and the spec at /openapi.yaml; defaults to true outside production
API_DOCS_ENABLED=
